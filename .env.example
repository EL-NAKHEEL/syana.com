APP_NAME="Al Nakheel Cool"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: https://<domain> (non-www). Every absolute URL, canonical and sitemap entry comes from here.
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development can use SQLite; production uses MySQL 8.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=alnakheel
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: true (HTTPS only cookies)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# true on a VPS with Supervisor; false on shared hosting (the scheduler drains the queue every minute).
QUEUE_SUPERVISED=false

CACHE_STORE=database
# CACHE_PREFIX=

# Full-page cache for guests (spatie/laravel-responsecache).
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_DRIVER=file
SETTINGS_CACHE_ENABLED=false

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="النخيل كوول"

# Where order/booking/backup notifications go.
NOTIFY_EMAIL=

# --- SEO / canonical host ---
# 301 to the APP_URL scheme+host (defaults to true in production).
SITE_FORCE_CANONICAL_HOST=false
# Comma-separated proxy IPs, or * behind a CDN/load balancer.
TRUSTED_PROXIES=*
INDEXNOW_ENABLED=false

# --- Security (PLAN.md §6.9) ---
# Enable only after HTTPS works on the production domain.
SECURITY_HSTS=false
# CSP starts report-only; set true after a clean week of reports (storage/logs/csp-*.log).
SECURITY_CSP_ENFORCE=false

# --- Backups (spatie/laravel-backup), daily DB + media ---
# Use "backups" (S3-compatible, below) in production. "local" keeps copies on the same server (not safe alone).
BACKUP_DISKS=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false

VITE_APP_NAME="${APP_NAME}"
