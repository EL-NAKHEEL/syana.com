includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - config
        - database
        - routes
    excludePaths:
        - database/content
        # Vendor-published configs that reference optional packages (MediaLibrary Pro, laravel-data).
        - config/media-library.php
        - config/settings.php
    ignoreErrors:
        # spatie/laravel-settings derives casts from docblock types and cannot parse array generics,
        # so these two settings arrays must stay untyped (see comments in the class).
        -
            identifier: missingType.iterableValue
            paths:
                - app/Settings/BusinessSettings.php
                - app/Settings/CalculatorSettings.php
